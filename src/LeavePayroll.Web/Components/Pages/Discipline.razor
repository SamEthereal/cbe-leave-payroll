@page "/discipline"
@using LeavePayroll.Domain.Discipline
@using LeavePayroll.Domain.Employees
@using LeavePayroll.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject LeavePayrollDbContext DbContext

<PageTitle>Disciplinary Records - CBE Leave & Payroll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Disciplinary Action Records</h2>
        <p class="text-muted mb-0">Confidential Disciplinary Cases, Misconduct Tracking & Appeals</p>
    </div>
    <button class="btn btn-danger shadow-sm" @onclick="ShowNewModal"><i class="bi bi-exclamation-triangle me-1"></i> Log Disciplinary Incident</button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Case #</th>
                        <th>Incident Date</th>
                        <th>Misconduct Category</th>
                        <th>Action Taken</th>
                        <th>Suspension</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Cases.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No active disciplinary cases on record.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Cases)
                        {
                            <tr>
                                <td><span class="badge bg-secondary font-monospace">@c.CaseNumber</span></td>
                                <td>@c.IncidentDate.ToShortDateString()</td>
                                <td><span class="badge bg-warning text-dark">@c.Category</span></td>
                                <td><span class="badge bg-danger">@c.ActionTaken</span></td>
                                <td>@(c.SuspensionDays.HasValue ? $"{c.SuspensionDays} Days" : "N/A")</td>
                                <td><span class="badge bg-success">@c.Status</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i> View Case</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (IsModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Log Disciplinary Action Form</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <form @onsubmit="SaveCase">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Select Employee</label>
                                <select class="form-select" @bind="NewCase.EmployeeId" required>
                                    <option value="">Select Employee...</option>
                                    @foreach (var emp in Employees)
                                    {
                                        <option value="@emp.Id">@emp.StaffId - @emp.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Misconduct Category</label>
                                <select class="form-select" @bind="NewCase.Category">
                                    <option value="@MisconductCategory.AttendancePunctuality">Attendance / Punctuality</option>
                                    <option value="@MisconductCategory.Insubordination">Insubordination / Failure to Follow Instructions</option>
                                    <option value="@MisconductCategory.BreachOfBankPolicy">Breach of Bank Policy or Procedure</option>
                                    <option value="@MisconductCategory.PoorPerformanceNegligence">Poor Performance / Negligence</option>
                                    <option value="@MisconductCategory.BreachOfConfidentiality">Breach of Confidentiality or Data Protection</option>
                                    <option value="@MisconductCategory.AmlKycComplianceBreach">AML / KYC Compliance Breach</option>
                                    <option value="@MisconductCategory.FraudDishonestyTheft">Fraud / Dishonesty / Theft</option>
                                    <option value="@MisconductCategory.HarassmentMisconduct">Harassment / Misconduct</option>
                                    <option value="@MisconductCategory.Other">Other</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Date of Incident</label>
                                <input type="date" class="form-control" @bind="NewCase.IncidentDate" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Disciplinary Action Recommended</label>
                                <select class="form-select" @bind="NewCase.ActionTaken">
                                    <option value="@DisciplinaryActionType.VerbalWarning">Verbal Warning</option>
                                    <option value="@DisciplinaryActionType.WrittenWarning">Written Warning</option>
                                    <option value="@DisciplinaryActionType.FinalWrittenWarning">Final Written Warning</option>
                                    <option value="@DisciplinaryActionType.Suspension">Suspension</option>
                                    <option value="@DisciplinaryActionType.Demotion">Demotion</option>
                                    <option value="@DisciplinaryActionType.SummaryDismissal">Summary Dismissal / Termination</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Description of Incident / Misconduct</label>
                                <textarea class="form-control" rows="3" @bind="NewCase.IncidentDescription" required placeholder="Detailed incident description..."></textarea>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Employee Response / Explanation</label>
                                <textarea class="form-control" rows="2" @bind="NewCase.EmployeeResponseStatement" placeholder="Summary of employee's statement during hearing..."></textarea>
                            </div>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-secondary me-2" @onclick="CloseModal">Cancel</button>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-save me-1"></i> Save Disciplinary Case</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DisciplinaryCase> Cases = [];
    private List<Employee> Employees = [];
    private bool IsModalOpen = false;
    private DisciplinaryCase NewCase = new();

    protected override async Task OnInitializedAsync()
    {
        Cases = await DbContext.DisciplinaryCases.ToListAsync();
        Employees = await DbContext.Employees.ToListAsync();
    }

    private void ShowNewModal()
    {
        NewCase = new DisciplinaryCase
        {
            CaseNumber = $"DISC-{DateTime.UtcNow:yyyyMM}-{Cases.Count + 1:D3}",
            IncidentDate = DateTime.UtcNow,
            ReportedDate = DateTime.UtcNow
        };
        IsModalOpen = true;
    }

    private void CloseModal() => IsModalOpen = false;

    private async Task SaveCase()
    {
        DbContext.DisciplinaryCases.Add(NewCase);
        await DbContext.SaveChangesAsync();
        Cases.Add(NewCase);
        IsModalOpen = false;
    }
}
